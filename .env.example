# Copy this file to ".env" and fill in your keys.

# --- Veo 3 (required to generate video) ---
# Get a key from Google AI Studio / Gemini. Veo access may require a paid tier.
GEMINI_API_KEY=your_google_gemini_api_key_here

# Optional: override the Veo model if the default name changes.
# If generation 404s, run `python list_models.py` to see what your key supports.
# VEO_MODEL=veo-3.1-generate-preview

# --- Voiceover ---
# Default engine is free edge-tts (no key). To use ElevenLabs instead:
# TTS_ENGINE=elevenlabs
# ELEVENLABS_API_KEY=your_elevenlabs_key_here
# ELEVENLABS_VOICE_ID=your_chosen_deep_male_voice_id
